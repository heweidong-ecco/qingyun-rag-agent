# ==================== 敏感配置（必填） ====================
# ==================== 阿里百炼 AI 服务 ====================
DASHSCOPE_API_KEY=sk-your-api-key-here
# ==================== 生成/对话 LLM —— 端点固定 DeepSeek（2026-10-02 起不再用百炼） ====================
# 🔴 `LLM_API_KEY` **必填**（缺失则拒绝启动）—— 它**不再回落** `DASHSCOPE_API_KEY`：
#    旧写法会把 **embedding 的 key** 拿去请求 **DeepSeek 端点**（静默错配）。
#    决策见 本仓的决策记录（⛔ 不随产品仓提供）。
# ⬜ 下面三个**可省**（`app/core/config.py:53-55` 已有 DeepSeek 默认值），写了就盖住默认值：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL_FAST=deepseek-v4-flash   # 轻量角色:查询改写/基础 Agent/RAG 答案(原 qwen-turbo 位)
# LLM_MODEL_CHAT=deepseek-v4-flash   # 重量角色:规划/质检/高级 Agent/流式(原 qwen-plus 位)
LLM_API_KEY=sk-your-deepseek-or-provider-key
# ==================== Embedding 模型（端点仍走阿里百炼 DashScope，⛔ 与上面的 LLM 不是一家） ====================
# ⬜ 可省（不写 = `app/core/config.py` 的字面默认值，**2026-10-14 B 段起 = 下面这行的新模型**），写了就盖住默认值。
# 🔴 **换它【必须连 维度 + 表定义 一起改】** —— 见 本仓的决策记录（⛔ 不随产品仓提供） §2.1：
#    只改模型名 ⇒ 维度对不上；而**最危险的是"维度恰好相同"**：不报错，但老向量与新查询
#    向量**不同源** ⇒ 检索结果全是垃圾。维度实测值：`text-embedding-v2` = 1536
#    `qwen3.7-text-embedding-flash` = 1024（2026-10-11 实调）。
# 🔴 **2026-10-14（B 段）：已经切到后者**，表定义也改成了 `vector(1024)`（`app/core/db.py`）。
# EMBEDDING_MODEL_MAIN=qwen3.7-text-embedding-flash
# ==================== JWT 认证 ====================
JWT_SECRET_KEY=your-jwt-secret-key-here
# ==================== 登录口令（必填） ====================
# ⚠️ 缺失则应用**拒绝启动**（config.validate_config）。
# 2026-09-15 从 app/access/auth.py 的硬编码字面量迁出 —— 那曾是公开仓库上的活凭据）。
# 生成随机口令：python3 -c "import secrets; print(secrets.token_urlsafe(24))"
LOGIN_PASSWORD=your-login-password-here
# ==================== 数据库（Docker 内部使用，一般不改） ====================
POSTGRES_PASSWORD=mysecretpassword
# ==================== 连接池大小设置 ====================
DB_MIN_CONN=2
DB_MAX_CONN=20
# ==================== 非敏感配置（可选，有默认值） ====================
# ==================== 登录用户名 ====================
LOGIN_USER_NAME=admin
# 可选：**设了才存在** test_user 账号（PREMIUM 角色）—— 用于验证非 admin 的配额/预算路径。
# 不设 = 该账号不存在（fail-closed，不留任何默认口令）。
# TEST_USER_PASSWORD=
# 注：原 API_KEY 配置项已删除 —— 全仓 0 个调用方（认证走 auth.verify_api_key + api_keys 表）。
# ==================== JWT 认证 ====================
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# ==================== 数据库（Docker 内部使用，一般不改） ====================
# 注：此处填 Docker 服务名；本地开发时 config.py 会自动覆盖为 localhost
POSTGRES_DB=rag_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# ==================== Redis（Docker 内部使用，一般不改） ====================
# 注：此处填 Docker 服务名；本地开发时 config.py 会自动覆盖为 localhost
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== 反向代理（按 IP 限流 · 2026-10-11 加） ====================
# 🔴 **默认 false，⛔ 别随便改 true** —— 这是**安全边界**，不是风格开关。
#    开了之后，限流会按 `X-Forwarded-For` / `X-Real-IP` 的第一跳分桶（而不是所有匿名共用一个桶）。
# ⚠️ **只有在【真代理后面】才开**：代理会覆盖客户端塞的那一跳 ⇒ 头里的第一跳才是真客户端
#    （魔搭创空间实测 2026-10-11，见 `docs/说明/魔搭创空间-部署与平台约束.md` §4.2）。
# 🔴 **本机 / 自建**部署**没有代理** ⇒ 那个头**谁都能伪造** ⇒ 开了它，
#    谁都能填一个 IP 换一个全新的限流桶 —— **比不做按 IP 还糟**。所以要显式开。
# ⚠️ 它只影响**限流分桶**，⛔ 不影响鉴权、⛔ 不影响配额身份。
TRUST_PROXY_HEADERS=false

# ==================== 人工审批（硬门 D · B4） ====================
# 哪些工具算「敏感」⇒ 命中就**停下来等人批**；⛔ 没登记的工具**默认不敏感、直接执行**。
# ⚠️ 这是**白名单**语义：新加的工具**默认不过审批**，要它过就加到这里。
# ⚠️ **留空会让服务启动就报错**（`validate_approval_config()`，空名单 = 审批永不触发）。
# 🔴 **写了【不存在的工具名】同样会让服务启动就报错**（2026-10-03 加）——
#    报错里会**列出可用的工具名**。⚠️ 这两种都是「**静默失效**」：审批永不触发但不报错。
# 🔵 第一版 = `web_search` 一个（需求方 2026-10-03 裁定）—— 它会**把问题外发到第三方**。
# ⚠️ 这里要写**工具名**（`tools` 里那个），⛔ **不是代码里的变量名**。
#    本仓真的栽过：默认值曾写成变量名 `search_tool`，与真名交集恒空 ⇒ **审批三天没触发过**。
SENSITIVE_TOOLS=web_search    # 需要人工审批的工具（逗号分隔）

# ==================== 人工审批轮次上限（硬门 D ·  §九） ====================
# 放行后模型**又**要求敏感工具 ⇒ 最多**再**批几轮（首次停 = 第 1 轮）。
# 到上限就**不再入队**：先注入「已达上限、请直接作答」让模型收尾（成功 ⇒ 响应 `forced_finish=true`）；
# 拦不住 ⇒ 该轮终止、返回 `status="error"`（⛔ 不再无限循环）。
# 🔴 非法值（非整数 / < 1）**回退默认 3，不报错** —— 与上面 `SENSITIVE_TOOLS` 相反（那个写错是静默失效）。
MAX_APPROVAL_ROUNDS=3

